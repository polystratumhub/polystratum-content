{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/polystratumhub/polystratum-content/schema/item.schema.json",
  "title": "Content item",
  "description": "One post on one platform at one slot. One file per item under content/<YYYY-MM-DD>/<id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "platform", "slot_ist", "format", "kind", "body", "hashtags",
               "media", "sources", "ai_generated", "ai_label"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-(li|ig|fb)-\\d{2}$",
      "description": "<date>-<platform code>-<sequence>, e.g. 2026-11-09-li-01."
    },
    "platform": {"enum": ["linkedin", "instagram", "facebook"]},
    "slot_ist": {
      "type": "string",
      "description": "Publish time in IST with an explicit +05:30 offset."
    },
    "format": {"enum": ["text", "image", "document_pdf", "carousel", "reel", "story"]},
    "kind": {
      "enum": ["founder_story", "subject", "session_promo", "build_log", "recap", "technique"],
      "description": "founder_story and subject follow the Principles & Messaging §11 ladders."
    },
    "ladder": {
      "type": "object",
      "description": "Optional. The §11 ladder parts, for review. Not published.",
      "additionalProperties": {"type": "string"}
    },
    "body": {"type": "string", "minLength": 1},
    "hashtags": {"type": "array", "items": {"type": "string", "pattern": "^#\\w+$"}},
    "first_comment": {"type": "string"},
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "alt", "synthetic"],
        "properties": {
          "path": {"type": "string"},
          "alt": {"type": "string", "minLength": 1},
          "synthetic": {"type": "boolean", "description": "True for a cloned voice, lip-sync or any generated likeness."}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "url"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "url": {"type": "string"}
        }
      }
    },
    "proof": {
      "type": "string",
      "description": "Where the real substance came from: a commit, a voice note, a call. Reviewed, not published."
    },
    "ai_generated": {"type": "boolean"},
    "ai_label": {"type": "boolean", "description": "Sets Meta's is_ai_generated flag and the burned-in tag."}
  }
}
